<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462;net8.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>RideBuilder.Affiliate</PackageId>
    <Description>Server-side SDK for RideBuilder FirstParty affiliate tracking: capture click_id and send checkout/return postbacks. Zero-dependency client + framework-free capture helpers.</Description>
    <PackageTags>ridebuilder;affiliate;attribution;postback</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- System.Text.Json is in-box on net8.0; everywhere else it must be referenced. This is the one
       first-party dependency the "zero-dep" core accepts (hand-rolling JSON is not worth it). -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- .NET Framework does not reference System.Net.Http by default, and HttpClient appears in this
       package's PUBLIC surface (the RideBuilderClient ctor). Without this, a consuming net4x project
       fails to compile with CS0012 even when it never touches HttpClient. Packing emits a
       <frameworkAssembly> entry, so the reference flows to consumers rather than stopping here. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
